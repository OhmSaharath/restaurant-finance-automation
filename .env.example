# Application
ENVIRONMENT=development
DEBUG=false
RATE_LIMIT_PER_MINUTE=30/minute
WEB_ENV_FILE=

# Supabase server-side configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-publishable-or-anon-key

# Google OAuth and Gmail ingestion (server-side only)
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3005/api/auth/callback/google
ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/your-topic
GMAIL_PUBSUB_VERIFICATION_TOKEN=
GMAIL_PUBSUB_AUDIENCE=

# Loyverse scheduled synchronization
LOYVERSE_CRON_AUDIENCE=

# FastAPI service URL used by Next.js server routes
INGESTION_API_BASE_URL=http://localhost:8080

# Stripe subscription billing (server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3005/billing?status=success
STRIPE_CANCEL_URL=http://localhost:3005/billing?status=cancelled
